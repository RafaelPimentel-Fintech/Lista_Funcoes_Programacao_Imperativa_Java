import java.util.ArrayList;
import java.util.Scanner;

public class SistemaEstatisticas {

    static int calcularQuantidade(ArrayList<Integer> numeros) {
        return numeros.size();
    }

    static int calcularSoma(ArrayList<Integer> numeros) {
        int soma = 0;
        for (int numero : numeros) {
            soma += numero;
        }
        return soma;
    }

    static double calcularMedia(ArrayList<Integer> numeros) {
        return (double) calcularSoma(numeros) / calcularQuantidade(numeros);
    }

    static int maiorNumero(ArrayList<Integer> numeros) {
        int maior = numeros.get(0);
        for (int numero : numeros) {
            if (numero > maior) {
                maior = numero;
            }
        }
        return maior;
    }

    static int menorNumero(ArrayList<Integer> numeros) {
        int menor = numeros.get(0);
        for (int numero : numeros) {
            if (numero < menor) {
                menor = numero;
            }
        }
        return menor;
    }

    static int quantidadePares(ArrayList<Integer> numeros) {
        int contador = 0;
        for (int numero : numeros) {
            if (numero % 2 == 0) {
                contador++;
            }
        }
        return contador;
    }

    static int quantidadeImpares(ArrayList<Integer> numeros) {
        int contador = 0;
        for (int numero : numeros) {
            if (numero % 2 != 0) {
                contador++;
            }
        }
        return contador;
    }

    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);
        ArrayList<Integer> numeros = new ArrayList<>();

        int numero = scanner.nextInt();
        while (numero != -1) {
            numeros.add(numero);
            numero = scanner.nextInt();
        }

        System.out.println("Quantidade de números: " + calcularQuantidade(numeros));
        System.out.println("Soma: " + calcularSoma(numeros));
        System.out.printf("Média: %.1f%n", calcularMedia(numeros));
        System.out.println("Maior número: " + maiorNumero(numeros));
        System.out.println("Menor número: " + menorNumero(numeros));
        System.out.println("Quantidade de pares: " + quantidadePares(numeros));
        System.out.println("Quantidade de ímpares: " + quantidadeImpares(numeros));

        scanner.close();
    }
}
